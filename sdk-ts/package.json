{
  "name": "@enterprise/agent-sdk",
  "version": "0.1.0",
  "description": "Enterprise Agent SDK for TypeScript: serves a LangGraph JS graph on the AgentCore runtime contract with built-in observability, guardrails, secrets, audit and approved models/tools.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/test",
    "!dist/examples",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test \"dist/test/*.test.js\"",
    "pack": "tsc && npm pack",
    "hello-agent": "node dist/examples/hello-agent/src/index.js"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "~3.1146.0",
    "@aws-sdk/client-ssm": "~3.1146.0",
    "@langchain/core": "~1.2.16",
    "@langchain/langgraph": "~1.4.19",
    "@langchain/openai": "~1.6.2",
    "@opentelemetry/api": "~1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "~0.222.0",
    "@opentelemetry/resources": "~2.11.0",
    "@opentelemetry/sdk-trace-base": "~2.11.0",
    "yaml": "~2.9.1",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@types/node": "~26.6.4",
    "typescript": "~7.0.2"
  },
  "bin": {
    "ent-agent-ts": "dist/src/cli.js"
  }
}
